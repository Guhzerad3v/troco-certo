# Copie este arquivo para ".env" (na mesma pasta) e preencha.
# O .env fica fora do Git, porque tem a senha do banco.

# Conexão com o MySQL
DB_HOST=localhost
DB_PORTA=3306
DB_USER=root
DB_SENHA=
DB_NOME=troco_certo

# Frase secreta usada para assinar o cookie de login (pode ser qualquer frase longa)
SEGREDO_SESSAO=troque-esta-frase-por-outra-bem-longa
